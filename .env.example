NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Alpha SMS (sms.net.bd). Required to send member OTP codes. Without it, phone+password
# signup still works but sending a code returns a real error (never fake-verified).
SMS_NET_BD_API_KEY=
# Server-only. Used to store hashed OTPs, mark numbers verified, and set passwords after reset.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Vercel Cron sends Authorization: Bearer <secret>.
# Required for /api/cron/birthday-wishes (00:20 Asia/Dhaka). Also used by /api/keep-alive if set.
CRON_SECRET=
# Partner applications (POST /api/partner) are inserted into public.partner_applications
# with this service role key. Apply supabase/migrations/20261115183000_partner_applications.sql
# first. If the key is unset, the API appends leads to gitignored data/partner-applications.ndjson.
