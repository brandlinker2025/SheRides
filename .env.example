NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Temporary: direct /admin dashboard access. Set false to restore /admin-login gating.
NEXT_PUBLIC_ADMIN_OPEN_ACCESS=true
# Alpha SMS (sms.net.bd). Required to send member OTP codes. Without it, phone+password
# signup still works but sending a code returns a real error (never fake-verified).
SMS_NET_BD_API_KEY=
# Server-only. Used to store hashed OTPs, mark numbers verified, and set passwords after reset.
SUPABASE_SERVICE_ROLE_KEY=
